{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!**/data",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/site",
      "!!**/vendor",
      "!!**/.git"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
